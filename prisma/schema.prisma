generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum StoryStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum SourceBias {
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
}

enum QuestionType {
  MULTIPLE_CHOICE
  RANKING
  AGREE_DISAGREE
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  name                String
  avatarUrl           String?   @map("avatar_url")
  authProvider        AuthProvider @default(EMAIL) @map("auth_provider")
  isAdmin             Boolean   @default(false) @map("is_admin")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  topics        UserTopic[]
  quizResponses UserQuizResponse[]
  bookmarks     Bookmark[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Topic {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String
  icon          String    @default("📋")
  parentTopicId String?   @map("parent_topic_id")
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")

  parentTopic   Topic?    @relation("TopicHierarchy", fields: [parentTopicId], references: [id])
  childTopics   Topic[]   @relation("TopicHierarchy")
  userTopics    UserTopic[]
  storyTopics   StoryTopic[]

  @@map("topics")
}

model UserTopic {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  topicId       String   @map("topic_id")
  interestLevel Int      @default(3) @map("interest_level")
  createdAt     DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

model Story {
  id                    String      @id @default(uuid())
  headline              String
  slug                  String      @unique
  summary               String
  commonGround          String      @map("common_ground") @db.Text
  leftNarrative         String      @map("left_narrative") @db.Text
  rightNarrative        String      @map("right_narrative") @db.Text
  implications          String      @db.Text
  status                StoryStatus @default(DRAFT)
  confidenceScore       Float       @default(0) @map("confidence_score")
  confidenceThresholdMet Boolean    @default(false) @map("confidence_threshold_met")
  publishedAt           DateTime?   @map("published_at")
  sourceArticleCount    Int         @default(0) @map("source_article_count")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  topics         StoryTopic[]
  sourceArticles SourceArticle[]
  bookmarks      Bookmark[]

  @@index([status])
  @@index([publishedAt])
  @@map("stories")
}

model StoryTopic {
  id             String @id @default(uuid())
  storyId        String @map("story_id")
  topicId        String @map("topic_id")
  relevanceScore Float  @default(1.0) @map("relevance_score")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([storyId, topicId])
  @@map("story_topics")
}

model SourceArticle {
  id         String     @id @default(uuid())
  storyId    String?    @map("story_id")
  title      String
  url        String     @unique
  sourceName String     @map("source_name")
  sourceBias SourceBias @map("source_bias")
  snippet    String?    @db.Text
  fetchedAt  DateTime   @default(now()) @map("fetched_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([storyId])
  @@map("source_articles")
}

model QuizQuestion {
  id           String       @id @default(uuid())
  questionText String       @map("question_text")
  questionType QuestionType @map("question_type")
  order        Int
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")

  options   QuizOption[]
  responses UserQuizResponse[]

  @@map("quiz_questions")
}

model QuizOption {
  id            String @id @default(uuid())
  questionId    String @map("question_id")
  optionText    String @map("option_text")
  topicMappings Json   @default("{}") @map("topic_mappings")
  order         Int

  question  QuizQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses UserQuizResponse[]

  @@map("quiz_options")
}

model UserQuizResponse {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  questionId       String   @map("question_id")
  selectedOptionId String   @map("selected_option_id")
  createdAt        DateTime @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuizOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("user_quiz_responses")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storyId   String   @map("story_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("bookmarks")
}

model AdminSettings {
  id                   String @id @default("default")
  confidenceThreshold  Float  @default(0.8) @map("confidence_threshold")
  autoPublishEnabled   Boolean @default(true) @map("auto_publish_enabled")
  ingestionIntervalMin Int    @default(60) @map("ingestion_interval_min")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}
